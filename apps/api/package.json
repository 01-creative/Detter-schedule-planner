{
  "name": "@detter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --local",
    "dev:node": "node --watch src/server.ts",
    "start:node": "node src/server.ts",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 execute detter --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute detter --remote --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "@detter/shared": "workspace:*",
    "@hono/node-server": "^1",
    "hono": "^4.13.22",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.168.0"
  }
}
