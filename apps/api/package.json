{
  "name": "@detter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build:node": "node scripts/build-node.mjs",
    "dev:node": "node scripts/build-node.mjs --watch",
    "start:node": "node dist/server.js",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 execute detter --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute detter --remote --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "@detter/shared": "workspace:*",
    "@hono/node-server": "^1",
    "hono": "^4.13.22",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "@types/node": "^22.20.7",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.168.0"
  }
}
